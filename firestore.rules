rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'admin';
    }

    // প্রোডাক্ট/সেটিংস: সবাই পড়তে পারবে, শুধু অ্যাডমিন লিখতে পারবে
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ইউজার: নিজের ডেটা নিজে, অ্যাডমিন সব
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // অ্যাডমিন তালিকা: শুধু অ্যাডমিন পড়তে পারবে
    match /adminUsers/{uid} {
      allow read: if isAdmin();
      allow write: if false; // Firebase Console থেকে অ্যাডমিন বানাতে হবে
    }

    // অর্ডার: যে কেউ বৈধ অর্ডার তৈরি করতে পারবে (সার্ভার-সাইড ভ্যালিডেশন
    // অ্যাপ লেয়ারে verifyPrice দিয়ে হয়); পড়তে পারবে শুধু নিজের (ইমেইল মিললে)
    // বা অ্যাডমিন। আপডেট শুধু অ্যাডমিন।
    match /orders/{id} {
      allow create: if request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.uid is string
        && request.resource.data.trxId is string
        && request.resource.data.status in ['Pending', 'Payment Verification'];
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerEmail == request.auth.email);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // পেমেন্ট সেটিংস: পড়া যাবে, লেখা শুধু অ্যাডমিন
    match /payments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
